<view class="custom-tab-shell">
  <view class="custom-tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="custom-tab-item {{selected === index ? 'is-active' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="custom-tab-icon custom-tab-icon--{{item.icon}}">
        <view class="custom-tab-icon__inner" />
        <view class="custom-tab-icon__head" />
        <view class="custom-tab-icon__body" />
      </view>
      <view class="custom-tab-label">{{item.text}}</view>
      <view class="custom-tab-indicator" />
    </view>
  </view>
</view>
