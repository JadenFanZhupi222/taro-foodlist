.custom-tab-shell{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:0 32rpx calc(16rpx + env(safe-area-inset-bottom));pointer-events:none}.custom-tab-bar{height:128rpx;display:flex;border-radius:32rpx;background:#fff;box-shadow:0 12rpx 36rpx rgba(32,36,31,.12);pointer-events:auto}.custom-tab-item{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#62685f}.custom-tab-item.is-active{color:#c9573a}.custom-tab-label{font-size:22rpx;line-height:1;margin-top:7rpx;font-weight:500}.is-active .custom-tab-label{font-weight:700}.custom-tab-indicator{position:absolute;bottom:9rpx;width:7rpx;height:7rpx;border-radius:50%;background:currentColor;opacity:0}.is-active .custom-tab-indicator{opacity:1}.custom-tab-icon{width:34rpx;height:34rpx;position:relative;border:3rpx solid currentColor;border-radius:8rpx}.custom-tab-icon--book::after{content:'';position:absolute;top:-3rpx;bottom:-3rpx;left:50%;border-left:2rpx solid currentColor}.custom-tab-icon--plate{border-radius:50%}.custom-tab-icon--plate .custom-tab-icon__inner{position:absolute;inset:7rpx;border:2rpx solid currentColor;border-radius:50%}.custom-tab-icon--person{border:0}.custom-tab-icon--person::before{content:'';position:absolute;width:14rpx;height:14rpx;left:10rpx;top:0;border:3rpx solid currentColor;border-radius:50%}.custom-tab-icon--person::after{content:'';position:absolute;left:3rpx;right:3rpx;bottom:0;height:15rpx;border:3rpx solid currentColor;border-radius:17rpx 17rpx 7rpx 7rpx}
