.custom-tab-shell{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:0 32rpx calc(16rpx + env(safe-area-inset-bottom));pointer-events:none}.custom-tab-bar{height:112rpx;display:flex;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(68,53,43,.14);pointer-events:auto}.custom-tab-item{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#62685f}.custom-tab-item.is-active{color:#c9573a}.custom-tab-label{font-size:21rpx;line-height:1;margin-top:6rpx;font-weight:500}.is-active .custom-tab-label{font-weight:700}.custom-tab-indicator{position:absolute;bottom:7rpx;width:6rpx;height:6rpx;border-radius:50%;background:currentColor;opacity:0}.is-active .custom-tab-indicator{opacity:1}.custom-tab-icon{width:32rpx;height:32rpx;position:relative}.custom-tab-icon__inner,.custom-tab-icon__head,.custom-tab-icon__body{display:none;position:absolute;border-color:currentColor}.custom-tab-icon--book{border:3rpx solid currentColor;border-radius:7rpx}.custom-tab-icon--book .custom-tab-icon__inner{display:block;top:-3rpx;bottom:-3rpx;left:50%;border-left:3rpx solid currentColor}.custom-tab-icon--plate{border:3rpx solid currentColor;border-radius:50%}.custom-tab-icon--plate .custom-tab-icon__inner{display:block;inset:6rpx;border:2rpx solid currentColor;border-radius:50%}.custom-tab-icon--person .custom-tab-icon__head{display:block;width:13rpx;height:13rpx;left:7rpx;top:0;border:3rpx solid currentColor;border-radius:50%}.custom-tab-icon--person .custom-tab-icon__body{display:block;left:0;right:0;bottom:0;height:14rpx;border:3rpx solid currentColor;border-radius:16rpx 16rpx 7rpx 7rpx}
